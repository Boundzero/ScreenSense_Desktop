# Normalize line endings. Keep LF in the repo for text files.
* text=auto eol=lf

# Windows-specific files should keep CRLF so they work when checked out.
*.bat text eol=crlf
*.inf text eol=crlf
*.ps1 text eol=crlf

# Treat these as binary (no EOL conversion, no diff).
*.png binary
*.ico binary
*.exe binary
*.zip binary
